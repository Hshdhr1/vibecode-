{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "outDir": "out",
        "rootDir": "src",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "sourceMap": true,
        "types": ["node", "vscode"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "out"]
}
